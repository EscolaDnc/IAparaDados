import seaborn as sns
import matplotlib.pyplot as plt
import pandas as pd

data = pd.DataFrame({
    'Região': ['Norte', 'Sul', 'Leste'],
    'Vendas': [35000, 42000, 30000]
})

sns.barplot(x='Região', y='Vendas', data=data)
plt.title('Vendas por Região')
plt.xlabel('Região')
plt.ylabel('Vendas (em R$)')
plt.show()